{
  "multipart": [
    {
      "when": {
        "axis": "x",
        "on_campfire": "false"
      },
      "apply": {
        "model": "orients_hotpot_chronicles:block/copper_yuanyang_o_hot_pot_shell"
      }
    },
    {
      "when": {
        "axis": "x",
        "on_campfire": "true"
      },
      "apply": {
        "model": "orients_hotpot_chronicles:block/copper_yuanyang_o_hot_pot_shell_on_campfire"
      }
    },
    {
      "when": {
        "axis": "z",
        "on_campfire": "false"
      },
      "apply": {
        "model": "orients_hotpot_chronicles:block/copper_yuanyang_o_hot_pot_shell",
        "y": 90
      }
    },
    {
      "when": {
        "axis": "z",
        "on_campfire": "true"
      },
      "apply": {
        "model": "orients_hotpot_chronicles:block/copper_yuanyang_o_hot_pot_shell_on_campfire",
        "y": 90
      }
    }
  ]
}
