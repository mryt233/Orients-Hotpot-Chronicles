{
  "schemaVersion": 1,
  "id": "orients_hotpot_chronicles",
  "version": "${version}",
  "name": "Orient's Hotpot Chronicles",
  "authors": [
    "mryt233"
  ],
  "description": "A bubbling Chongqing nine-grid hotpot on a brick stove: fuel the stove, seat a copper or iron pot, pour in a broth, drop ingredients into the 9x9 grid and pick them out cooked (with furnace XP) - all with one pair of chopsticks.",
  "license": [
    "MIT",
    "CC-BY-NC-SA-4.0"
  ],
  "icon": "assets/orients_hotpot_chronicles/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "cn.blockforge.generated.orientshotpotchronicles.GeneratedMod"
    ],
    "client": [
      "cn.blockforge.generated.orientshotpotchronicles.client.HotPotClient"
    ],
    "modmenu": [
      "cn.blockforge.generated.orientshotpotchronicles.fabric.client.HotPotModMenuCompat"
    ],
    "jei_mod_plugin": [
      "cn.blockforge.generated.orientshotpotchronicles.client.compat.jei.HotPotJeiPlugin"
    ],
    "rei_client": [
      "cn.blockforge.generated.orientshotpotchronicles.client.compat.rei.HotPotReiClientPlugin"
    ],
    "jade": [
      "cn.blockforge.generated.orientshotpotchronicles.compat.jade.HotPotJadePlugin"
    ]
  },
  "mixins": [
    "orients_hotpot_chronicles.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.14.21",
    "minecraft": "1.20.1",
    "java": ">=17",
    "fabric-api": ">=0.83.0",
    "orient_framework": ">=0.1.3 <0.2.0"
  },
  "suggests": {
    "farmersdelight": "*",
    "crocosmia": "*",
    "jei": "*",
    "roughlyenoughitems": "*",
    "jade": "*",
    "modmenu": "*"
  }
}
